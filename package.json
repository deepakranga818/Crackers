{
  "name": "diwali-crackers-catalogue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "images": "python scripts/resolve_images.py",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "demo": "vite --host 127.0.0.1 --port 5180 --strictPort --mode checkout-demo",
    "demo:lan": "vite --host 0.0.0.0 --port 5180 --strictPort --mode checkout-demo",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:layout": "playwright test layout.spec.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "test:basepath": "playwright test --config playwright.basepath.config.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
