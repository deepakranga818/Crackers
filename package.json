{
  "name": "diwali-crackers-catalogue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run sync && vite --host 127.0.0.1",
    "sync": "python scripts/sync_google_sheet.py && npm run import && python scripts/resolve_images.py --download-supplied-images --only-missing && npm run import",
    "import": "python scripts/import_products.py",
    "build": "npm run sync && tsc -b && vite build",
    "build:offline": "npm run import && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "demo:data": "node demo/make-demo-data.mjs",
    "demo": "npm run demo:data && vite --host 127.0.0.1 --port 5180 --strictPort --mode checkout-demo",
    "demo:lan": "npm run demo:data && vite --host 0.0.0.0 --port 5180 --strictPort --mode checkout-demo",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev:demo": "npm run sync && vite --host 127.0.0.1 --mode demo",
    "test:layout": "playwright test layout.spec.ts",
    "test:live": "npm run sync && python -m unittest discover -s tests -p test_import.py && node scripts/check-sheet-drift.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
