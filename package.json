{
  "name": "diwali-crackers-catalogue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "import": "python scripts/import_products.py",
    "build": "npm run import && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
